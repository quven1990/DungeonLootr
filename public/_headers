# Hashed build assets: long-cache is safe because filenames change every deploy.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Favicons / icons can be cached longer; names are stable but rarely change.
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon-*.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
